                        }
                    }
                ],
                "responses": {}
            }
        }
    },
    "definitions": {
        "handler.PaymentRequest": {
            "type": "object",
            "required": [
                "amount",
                "userId"
            ],
            "properties": {
                "amount": {
                    "type": "integer",
                    "example": 1000
                },
                "userId": {
                    "type": "string",
                    "example": "123e4567-e89b-12d3-a456-426614174000"
                }
            }
        }
    }
