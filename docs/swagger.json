    "paths": {
        "/payment": {
            "post": {
                "description": "Регистрирует платёж и отправляет его на обработку",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Payment"
                ],
                "summary": "Совершить платёж",
                "parameters": [
                    {
                        "description": "Данные платежа",
                        "name": "request",
