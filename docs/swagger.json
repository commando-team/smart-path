{
    "swagger": "2.0",
    "info": {
        "contact": {}
    },
    "paths": {
        "/payment": {
            "post": {
                "description": "Регистрирует платёж и отправляет его на обработку",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Payment"
                ],
                "summary": "Совершить платёж",
                "parameters": [
                    {
                        "description": "Данные платежа",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/handler.PaymentRequest"
                        }
                    }
                ],
                "responses": {}
            }
        },
        "/payment/{id}": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Payment"
                ],
                "summary": "Получить данные о платёже",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Идентификатор платежа (UUID)",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/db.Payment"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "db.Payment": {
            "type": "object",
            "properties": {
                "amount": {
                    "type": "integer",
                    "format": "int64"
                },
                "id": {
                    "type": "string"
                },
                "status": {
                    "$ref": "#/definitions/db.PaymentStatus"
                },
                "userID": {
                    "type": "string"
                }
            }
        },
        "db.PaymentStatus": {
            "type": "string",
            "enum": [
                "pending",
                "success",
                "failure"
            ],
            "x-enum-varnames": [
                "PaymentStatusPending",
                "PaymentStatusSuccess",
                "PaymentStatusFailure"
            ]
        },
        "handler.PaymentRequest": {
            "type": "object",
            "required": [
                "amount",
                "userId"
            ],
            "properties": {
                "amount": {
                    "type": "integer",
                    "example": 1000
                },
                "userId": {
                    "type": "string",
                    "example": "123e4567-e89b-12d3-a456-426614174000"
                }
            }
        }
    }
}